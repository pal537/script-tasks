#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/info.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
PORT=18788

if [ -n "${TRIM_DATA_SHARE_PATHS:-}" ]; then
    DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
else
    DATA_DIR="${TRIM_APPDEST}/shares/script-tasks/data"
fi

CMD="env ST_DATA_DIR=${DATA_DIR} ST_PORT=${PORT} ST_SOCK=${TRIM_APPDEST}/app.sock ${TRIM_APPDEST}/bin/script-tasks"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> ${LOG_FILE}
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    else
        return 1
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            rm -f "${PID_FILE}"
        fi
    fi
    return 1
}

start_process() {
    if status; then
        return 0
    fi
    mkdir -p "${DATA_DIR}" "${TRIM_PKGVAR}"
    log_msg "Starting script-tasks (data=${DATA_DIR}) ..."
    bash -c "${CMD}" >> ${LOG_FILE} 2>&1 &
    printf "%s" "$!" > ${PID_FILE}
    local i
    for i in $(seq 1 15); do
        if [ -S "${TRIM_APPDEST}/app.sock" ]; then
            log_msg "script-tasks ready on socket ${TRIM_APPDEST}/app.sock"
            return 0
        fi
        if ! status; then
            log_msg "process exited during startup"
            return 1
        fi
        sleep 1
    done
    log_msg "port ${PORT} not ready in 15s"
    return 1
}

stop_process() {
    log_msg "Stopping script-tasks ..."
    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if ! check_process "${pid}"; then
            rm -f "${PID_FILE}"
            return 0
        fi
        kill -TERM ${pid} >> ${LOG_FILE} 2>&1
        local count=0
        while check_process "${pid}" && [ $count -lt 10 ]; do
            sleep 1
            count=$((count + 1))
        done
        if check_process "${pid}"; then
            kill -KILL "${pid}"
            sleep 1
        fi
        rm -f "${PID_FILE}"
    fi
    return 0
}

case $1 in
start)
    start_process
    ;;
stop)
    stop_process
    ;;
status)
    if status; then
        exit 0
    else
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
